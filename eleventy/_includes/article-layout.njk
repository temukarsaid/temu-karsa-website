        Konsultasi Gratis
        <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg></i>
      </a>
      <button class="burger" id="burger" aria-label="Buka menu" aria-expanded="false" aria-controls="nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<main>

  <!-- =============================================================== JUDUL -->
  <section class="section" id="blog-head">
    <div class="wrap">
      <nav class="breadcrumb breadcrumb--light" aria-label="Breadcrumb" data-reveal>
        <ol>
          <li><a href="index.html">Beranda</a></li>
          <li><a href="artikel.html">Artikel</a></li>
          <li aria-current="page">{{ article.title }}</li>
        </ol>
      </nav>

      <div class="blog-detail__head">
        <div class="blog-detail__head-left">
          <span class="blog-detail__eyebrow" data-reveal>{{ article.readTime }}</span>
          <h1 class="blog-detail__title" data-reveal data-delay="60">{{ article.title }}</h1>
        </div>

        <div class="blog-detail__head-right" data-reveal data-delay="120">
          <div class="blog-detail__author">
            <span class="blog-detail__author-avatar">
              <img src="assets/img/favicon-mark.png" alt="">
            </span>
            <span>Tim Temu Karsa</span>
          </div>
        </div>
      </div>

      <!-- ========================================================== HERO -->
      <div class="blog-detail__hero" data-reveal data-delay="180">
        <img src="{{ article.heroImage }}" alt="{{ article.heroImageAlt }}">
      </div>

      <!-- ==================================================== ISI ARTIKEL -->
      <div class="blog-detail__layout">
      <div class="blog-detail__body">
        {% for p in article.leadParagraphs %}
        <p class="blog-detail__lead" data-reveal>{{ p }}</p>
        {% endfor %}

        {% for s in article.sections %}
        {% if s.quote %}
        <blockquote class="blog-detail__quote" data-reveal>
          {{ s.quote }}
        </blockquote>
        {% else %}
        <div class="blog-detail__section{% if s.wide or s.table %} blog-detail__section--wide{% endif %}"{% if s.id %} id="{{ s.id }}"{% endif %} data-reveal>
          {% if s.heading %}<h2>{{ s.heading }}</h2>{% endif %}
          {{ s.body | markdownify | safe }}
          {% if s.table %}
          <div class="blog-table__wrap">
            <table class="blog-table{% if s.table.split %} blog-table--split{% endif %}">
              <thead>
                <tr>{% for h in s.table.headers | splitPipe %}<th>{{ h }}</th>{% endfor %}</tr>
              </thead>
              <tbody>
                {% for row in s.table.rows %}
                <tr>{% for cell in row | splitPipe %}<td>{{ cell }}</td>{% endfor %}</tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% endif %}
        </div>
        {% endif %}
        {% endfor %}

        <div class="blog-detail__share" data-reveal>
          <span class="blog-detail__share-label">Share Artikel Ini</span>
          <div class="socials contact__socials">
            <a href="mailto:halo@temukarsa.id" aria-label="Email">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
            </a>
            <a href="https://www.linkedin.com/company/temu-karsa/" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 1 0-4 0v7h-4V8h4v1.5A6 6 0 0 1 16 8z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="https://www.instagram.com/temukarsa.id/" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/></svg>
            </a>
            <a href="https://wa.me/6285121558129" target="_blank" rel="noopener" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.4A10 10 0 1 0 12 2z"/><path d="M8.6 9.2c.3 2.6 3.6 5.9 6.2 6.2l1-1.4 1.9.8-.3 1.6c-2.9.9-8.7-4.9-7.8-7.8l1.6-.3.8 1.9z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <aside class="blog-toc" data-reveal data-delay="120">
        <div class="blog-toc__inner">
          <div class="blog-toc__head">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
            Daftar Isi
          </div>
          <nav class="blog-toc__nav">
            {% for s in article.sections %}
            {% if s.heading and s.showInToc != false and s.id %}
            <a class="blog-toc__link" href="#{{ s.id }}">{{ s.heading }}</a>
            {% endif %}
            {% endfor %}
          </nav>
        </div>
      </aside>
      </div>
    </div>
  </section>

  <!-- ========================================================= KATA KUNCI -->
  <section class="section" id="kata-kunci">
    <div class="wrap">
      <h2 class="related-articles__title" data-reveal>Kata Kunci</h2>
      <div class="keyword-list" data-reveal data-delay="60">
        {% for kw in article.keywords %}
        <span class="keyword-chip">#{{ kw }}</span>
        {% endfor %}
      </div>
    </div>
  </section>

  <div class="wrap"><hr class="section-divider"></div>

  <!-- ============================================== ARTIKEL TERBARU LAINNYA -->
  {% set related = articles | latestArticlesExcept(article.slug, 3) %}
  <section class="section" id="artikel-terbaru">
    <div class="wrap">
      <div class="article-section__head" data-reveal>
        <div>
          <h2 class="related-articles__title">Artikel Terbaru Lainnya</h2>
          <p class="related-articles__subtitle">Baca artikel pilihan terbaru mengenai legalitas, pendirian usaha, dan perpajakan.</p>
        </div>
        <div class="article-section__nav" data-reveal data-delay="100">
          <a class="link-arrow article-section__all" href="artikel.html">
            Lihat Semua Artikel
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>
        </div>
      </div>

      <div class="article-grid">
        {% for rel in related %}
        <div class="article-tile" data-reveal data-delay="{{ 80 + loop.index0 * 60 }}">
          <div class="article-tile__img">
            <img src="{{ rel.heroImage }}" alt="{{ rel.heroImageAlt }}">
            <span class="article-tile__chip">{{ rel.category }}</span>
          </div>
          <div class="article-tile__meta">
            <span>{{ rel.readTime }}</span>
            <span>{{ rel.dateDisplay }}</span>
          </div>
          <h3 class="article-tile__title">{{ rel.title }}</h3>
          <p class="article-tile__desc">{{ rel.metaDescription }}</p>
          <a class="btn btn--ghost btn--sm" href="{{ rel.slug }}.html">
            Baca Selengkapnya
            <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg></i>
          </a>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ================================================================= CTA -->
  <section class="section cta-section" id="konsultasi">

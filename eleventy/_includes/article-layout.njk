<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ article.title }} | Temu Karsa</title>
<meta name="description" content="{{ article.metaDescription }}">
<meta name="theme-color" content="#041C4F">

<!-- Open Graph -->
<meta property="og:type" content="article">
<meta property="og:title" content="{{ article.title }} | Temu Karsa">
<meta property="og:description" content="{{ article.ogDescription or article.metaDescription }}">
<meta property="og:image" content="assets/img/logo-temu-karsa.png">

<link rel="canonical" href="https://www.temukarsa.com/{{ article.slug }}.html">

{% set articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.title,
  "description": article.metaDescription,
  "image": "https://www.temukarsa.com/" + article.heroImage,
  "datePublished": article.date,
  "dateModified": article.date,
  "author": { "@type": "Organization", "name": "Temu Karsa" },
  "publisher": {
    "@type": "Organization",
    "name": "Temu Karsa",
    "logo": { "@type": "ImageObject", "url": "https://www.temukarsa.com/assets/img/logo-temu-karsa.png" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.temukarsa.com/" + article.slug + ".html" }
} %}
<script type="application/ld+json">{{ articleLd | dump | safe }}</script>

{% set localBusinessLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Temu Karsa",
  "image": "https://www.temukarsa.com/assets/img/logo-temu-karsa.png",
  "url": "https://www.temukarsa.com/",
  "telephone": "+6285121558129",
  "email": "halo@temukarsa.id",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Ruko Taman Juanda, Jl. Pahlawan Blok B1 No.3",
    "addressLocality": "Bekasi Timur",
    "addressRegion": "Jawa Barat",
    "postalCode": "17111",
    "addressCountry": "ID"
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    "opens": "08:00",
    "closes": "17:00"
  }
} %}
<script type="application/ld+json">{{ localBusinessLd | dump | safe }}</script>

<link rel="icon" type="image/png" href="assets/img/favicon-mark.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/css/style.css">
</head>
<body>

<!-- =============================================================== HEADER

      <div class="contact__grid">
        <div class="contact__info">
          <span class="section-kicker" data-reveal>Kontak Kami</span>
          <h2 class="intro-heading" data-reveal data-delay="60">
            <span class="intro-heading__strong">Konsultasikan Bisnis Anda Sekarang.</span>
            <span class="intro-heading__soft">Tim kami siap membantu proses legalitas dan ruang kerja
            Anda — kami merespons setiap pengajuan dalam 1x24 jam kerja.</span>
          </h2>

          <div class="socials contact__socials" data-reveal data-delay="100">

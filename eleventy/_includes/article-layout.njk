              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
            </a>
            <a href="https://www.linkedin.com/company/temu-karsa/" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 1 0-4 0v7h-4V8h4v1.5A6 6 0 0 1 16 8z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="https://www.instagram.com/temukarsa.id/" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/></svg>
            </a>
            <a href="https://wa.me/6285121558129" target="_blank" rel="noopener" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.4A10 10 0 1 0 12 2z"/><path d="M8.6 9.2c.3 2.6 3.6 5.9 6.2 6.2l1-1.4 1.9.8-.3 1.6c-2.9.9-8.7-4.9-7.8-7.8l1.6-.3.8 1.9z"/></svg>
            </a>
          </div>
        </div>

        <form class="form-card" id="bookingForm" data-reveal data-delay="140">
          <div class="form-grid">
            <div class="field">
              <label for="cfNama">Nama Depan</label>
              <input type="text" id="cfNama" name="nama" placeholder="Masukkan nama depan" required>
            </div>
            <div class="field">
              <label for="cfNamaBelakang">Nama Belakang</label>
              <input type="text" id="cfNamaBelakang" name="nama_belakang" placeholder="Masukkan nama belakang">
            </div>

            <div class="field">
              <label for="cfEmail">Alamat Email</label>
              <input type="email" id="cfEmail" name="email" placeholder="Masukkan email" required>
            </div>
            <div class="field">
              <label for="cfPhone">Nomor WhatsApp</label>
              <input type="tel" id="cfPhone" name="telepon" placeholder="Masukkan nomor WhatsApp" required>
            </div>

            <div class="field">
              <label for="cfLayanan">Jenis Layanan</label>
              <select id="cfLayanan" name="layanan" required>
                <option value="" selected disabled>Pilih layanan</option>
                <option selected>Pendirian Badan Usaha</option>
                <option>Perubahan Badan Usaha</option>
                <option>Pengurusan Legalitas</option>
              </select>
            </div>
            <div class="field">
              <label for="cfJadwal">Tanggal &amp; Waktu Konsultasi</label>
              <input type="datetime-local" id="cfJadwal" name="jadwal">
            </div>

            <div class="field field--full">
              <label for="cfPesan">Pesan</label>
              <textarea id="cfPesan" name="pesan" placeholder="Ceritakan kebutuhan bisnis Anda..."></textarea>
            </div>

            <button type="submit" class="btn btn--light field--full contact__submit">
              Ajukan Konsultasi
              <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg></i>
            </button>

            <p class="form-note field--full">
              Data Anda aman bersama kami dan hanya digunakan untuk keperluan konsultasi.
              Baca <a href="kebijakan-privasi.html">Kebijakan Privasi</a> kami.
            </p>
            <p class="form-status" id="formStatus"></p>
          </div>
        </form>
      </div>
    </div>
  </section>

</main>


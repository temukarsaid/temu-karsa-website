          </div>
          <div class="nav__dd-col">
            <a class="nav__dd-title" href="penyewaan-space.html">Penyewaan Space &amp; Ruang Kerja</a>
            <a href="virtual-office.html">Virtual Office</a>
            <a href="private-office.html">Private Office</a>
            <a href="coworking-space.html">Coworking Space</a>
            <a href="meeting-room.html">Meeting Room</a>
          </div>
        </div>
      </div>

      <a href="tentang-kami.html">Tentang Kami</a>
      <a href="karsabiz.html">KarsaBiz</a>
      <a href="artikel.html">Artikel</a>
      <a href="kontak.html">Kontak</a>
      <a href="kebijakan-privasi.html">Kebijakan Privasi</a>
    </nav>

    <div class="header__cta">
